# Somente configurações públicas. Nunca coloque credenciais Salesforce aqui.
# Sem endpoint, npm run dev usa demonstração. O build de produção não simula envio.
VITE_LEADS_ENDPOINT=
# Contexto de sessão + convite. Sem este endpoint, todos usam cadastro público.
VITE_RESOLVE_ENDPOINT=
VITE_PRIVACY_URL=
# Reservado, sem botão de app no fluxo de fallback atual.
VITE_APP_URL=
# Preencher com a versão aprovada do texto fornecido antes de publicar.
VITE_LEGAL_VERSION=
